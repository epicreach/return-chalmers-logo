{
  "manifest_version": 3,
  "name": "Return Chalmers Logo",
  "version": "0.1",

  "description": "Returns the old Chalmers logo and replaces the new one.",

  "icons": {
    "48": "icons/chalmers_logo.svg"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "returnchalmerslogo@mozilla.org",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "content_scripts": [
    {
      "matches": ["*://*.chalmers.se/*"],
      "js": ["returnchalmers.js"]
    }
  ]
}
